# Supabase — URL과 anon key는 브라우저에도 노출되므로 NEXT_PUBLIC_ 하나로 통일한다.
# 서버 코드도 같은 이름을 읽으므로 SUPABASE_URL / SUPABASE_ANON_KEY 는 더 이상 쓰지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=Food-Cafe

# service role key는 RLS를 우회하므로 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 게시글·레시피·조합 쓰기를 앱 서버 요청만 받게 하는 값. 서버가 x-app-server-key 헤더로 보내고 DB Vault의 app_server_key와 비교한다.
# 절대 NEXT_PUBLIC_ 을 붙이지 않는다. 값이 없거나 Vault와 다르면 조회는 되고 콘텐츠 쓰기만 거절된다(fail-closed).
# 로컬 Supabase는 supabase/seed.sql의 local-dev-app-server-key, 원격은 vault.create_secret으로 넣은 무작위 값.
SUPABASE_APP_SERVER_KEY=

# Supabase CLI 전용 (마이그레이션 적용 등)
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
PGPASSWORD=

# Vercel Cron이 내부 이미지 정리 엔드포인트를 호출할 때 쓰는 비밀값.
# 값이 없으면 엔드포인트는 항상 401을 반환한다(fail-closed).
CRON_SECRET=

# 1로 두면 이미지 정리가 실제 삭제 없이 대상 목록만 반환한다.
# 삭제는 되돌릴 수 없으므로 첫 실행 전에 켜서 목록을 확인할 것.
STORAGE_CLEANUP_DRY_RUN=

# 애플리케이션
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_KAKAO_JS_KEY=

# AI 레시피 추천 — 서버 전용이며 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
AI_GATEWAY_API_KEY=
AI_RECOMMEND_MODEL=
AI_RECOMMEND_EMBEDDING_MODEL=

# Playwright E2E 전용 테스트 계정
# 실제 값은 Git에 올리지 않는 .env.e2e.local에 작성한다.
# 격리된 테스트 DB에서 쓰기 시나리오를 실행할 때만 true로 설정한다.
E2E_ENABLE_MUTATIONS=false
E2E_AUTHOR_EMAIL=
E2E_AUTHOR_PASSWORD=
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
E2E_OTHER_USER_ID=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# 비밀번호 재설정 E2E 전용 계정(선택). 테스트가 비밀번호를 바꾼 뒤 원래 값으로 되돌린다.
E2E_RESET_EMAIL=
E2E_RESET_PASSWORD=

# 게시글 멘션 후보 검증이 필요할 때만 입력한다.
E2E_MENTION_QUERY=
E2E_MENTION_EXPECTED_NAME=
