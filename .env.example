# Supabase — URL과 anon key는 브라우저에도 노출되므로 NEXT_PUBLIC_ 하나로 통일한다.
# 서버 코드도 같은 이름을 읽으므로 SUPABASE_URL / SUPABASE_ANON_KEY 는 더 이상 쓰지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=Food-Cafe

# service role key는 RLS를 우회하므로 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI 전용 (마이그레이션 적용 등)
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
PGPASSWORD=

# Vercel Cron이 내부 이미지 정리 엔드포인트를 호출할 때 쓰는 비밀값.
# 값이 없으면 엔드포인트는 항상 401을 반환한다(fail-closed).
CRON_SECRET=

# 1로 두면 이미지 정리가 실제 삭제 없이 대상 목록만 반환한다.
# 삭제는 되돌릴 수 없으므로 첫 실행 전에 켜서 목록을 확인할 것.
STORAGE_CLEANUP_DRY_RUN=

# 애플리케이션
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_KAKAO_JS_KEY=
