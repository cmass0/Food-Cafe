          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{container=~\"supabase-(db|rest|kong|auth|storage|realtime|analytics)|lb\"}[$__rate_interval]))",
          "legendFormat": "{{container}}",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(host_cpu_seconds_total[$__rate_interval])) - sum(rate(host_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "PC 전체",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PC 전체"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "B"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
